# Prod — Firebase project mobile-seller-v3
# Copy to .env.prod and fill in from Firebase Console > Project settings > Your apps (web app).
# Used by: pnpm android:prod  /  pnpm apk:prod  (scripts/with-env.js)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=mobile-seller-v3.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=mobile-seller-v3
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional
# EXPO_PUBLIC_FIREBASE_DATABASE_URL=
# EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
# EXPO_PUBLIC_DATADOG_CLIENT_TOKEN=
# EXPO_PUBLIC_DATADOG_APPLICATION_ID=
