{
  "name": "mseller-lite",
  "main": "expo-router/entry",
  "packageManager": "pnpm@10.12.4",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "dev:firebase-local": "EXPO_PUBLIC_EMULATOR_ENABLED=true EXPO_PUBLIC_LOCAL_MODE=true EXPO_PUBLIC_USE_LOCAL_API=true EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=192.168.1.187 EXPO_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_PORT=8080 EXPO_PUBLIC_LOCAL_API_PORT=7173 EXPO_PUBLIC_TARGET=http://192.168.1.187:7173 TARGET=http://192.168.1.187:7173 expo start",
    "start:local": "EXPO_PUBLIC_LOCAL_MODE=true EXPO_PUBLIC_USE_LOCAL_API=true expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android:dev": "node scripts/with-env.js development expo run:android",
    "android:prod": "node scripts/with-env.js production expo run:android",
    "apk:dev": "node scripts/with-env.js development expo run:android --variant release",
    "apk:prod": "node scripts/with-env.js production expo run:android --variant release",
    "distribute:dev": "node scripts/with-env.js development node scripts/distribute-android.js",
    "distribute:prod": "node scripts/with-env.js production node scripts/distribute-android.js",
    "distribute:ios:dev": "node scripts/distribute-ios.js development",
    "distribute:ios:prod": "node scripts/distribute-ios.js production",
    "start:dev": "node scripts/with-env.js development expo start --dev-client",
    "start:prod": "node scripts/with-env.js production expo start --dev-client",
    "android:local": "EXPO_PUBLIC_LOCAL_MODE=true EXPO_PUBLIC_USE_LOCAL_API=true expo start --android",
    "ios": "expo run:ios",
    "ios:local": "EXPO_PUBLIC_LOCAL_MODE=true EXPO_PUBLIC_USE_LOCAL_API=true expo start --ios",
    "web": "expo start --web",
    "web:local": "EXPO_PUBLIC_LOCAL_MODE=true EXPO_PUBLIC_USE_LOCAL_API=true expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "setup-template": "./setup-template.sh",
    "validate-template": "pnpm lint && pnpm exec tsc --noEmit",
    "build:android:prod": "eas build -p android --profile production --clear-cache",
    "build:ios:prod": "eas build -p ios --profile production",
    "build:store": "eas build -p all --profile production",
    "submit:android": "eas submit -p android --profile production --latest",
    "submit:ios": "eas submit -p ios --profile production --latest",
    "build:android:dev": "eas build -p android --profile development --clear-cache",
    "build:android:preview-dev": "eas build -p android --profile preview-dev",
    "build:android:preview-prod": "eas build -p android --profile preview-prod",
    "expo-doctor": "npx expo-doctor"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-native-vector-icons/material-design-icons": "^12.2.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@types/axios": "^0.9.36",
    "axios": "^1.11.0",
    "dotenv": "^17.2.1",
    "expo": "~54.0.37",
    "expo-blur": "~15.0.7",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.12",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.8",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.8",
    "expo-localization": "~17.0.7",
    "expo-location": "~19.0.8",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.5",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.7",
    "expo-web-browser": "~15.0.7",
    "firebase": "^12.0.0",
    "i18next": "^25.3.2",
    "qrcode-generator": "^2.0.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^15.6.1",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@jest/globals": "~29.7.0",
    "@react-native/typescript-config": "^0.80.2",
    "@types/jest": "29.5.14",
    "@types/node": "^24.4.0",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.18",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/"
    ]
  }
}
