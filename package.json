    "expo-image": "~3.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.8",
    "expo-localization": "~17.0.7",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.5",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
