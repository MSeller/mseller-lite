# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Claude Code worktrees
.claude/worktrees/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# service-account key that google-github-actions/auth writes into the workspace in CI.
# Untracked files there would also make the distribute scripts refuse a "dirty" tree.
gha-creds-*.json

# environment setup scripts (contain sensitive data)
scripts/setup-env-vars.sh
scripts/setup-all-env-vars.sh
scripts/*env*-local.sh

# typescript
*.tsbuildinfo

app-example
.env
# per-environment device builds (scripts/with-env.js); the .example files are committed.
# Not .env.development/.env.production: Expo auto-loads those by NODE_ENV.
.env.dev
.env.prod
# Native projects are generated by `expo prebuild` (CNG)
/android
/ios

# pnpm is the only package manager
package-lock.json
yarn.lock

# google-github-actions/auth writes its credentials into the workspace
gha-creds-*.json

# Editor swap files and macOS AppleDouble metadata. A tracked app/._layout.tsx.swp
# made EAS iOS builds fail to unpack the project ("Failed to restore metadata").
*.swp
*.swo
._*

# Local Expo module build outputs (Gradle / Xcode)
modules/*/android/build/
modules/*/android/.gradle/
modules/*/ios/build/
